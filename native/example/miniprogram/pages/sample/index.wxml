<view id="card" style="{{mirrorFontFamily ? 'font-family:' + mirrorFontFamily : ''}}">
  <text id="title">{{title}}</text>
  <button id="toggle" bindtap="toggle" style="{{mirrorFontFamily ? 'font-family:' + mirrorFontFamily : ''}}">
    <text wx:if="{{expanded}}" id="expanded">收起记录</text>
    <text wx:else id="collapsed">查看记录</text>
  </button>
  <text wx:if="{{expanded}}" id="detail">叶脉清晰，边缘呈锯齿形。</text>
</view>
